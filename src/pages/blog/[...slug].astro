---
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogPost from '../../components/BlogPost.astro';
import { it } from '../../i18n/it';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const itPosts = allPosts.filter((p) => p.data.locale === 'it');
  return itPosts.map((post) => {
    const cleanSlug = post.slug.replace(/^it\//, '');
    const translations = post.data.translationKey
      ? allPosts.filter(
          (p) => p.data.locale !== 'it' && p.data.translationKey === post.data.translationKey,
        )
      : [];
    return {
      params: { slug: cleanSlug },
      props: { post, translations },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  translations: CollectionEntry<'blog'>[];
}

const { post, translations } = Astro.props;
const { Content } = await post.render();
---

<BlogPost locale="it" strings={it} post={post} translations={translations}>
  <Content />
</BlogPost>
