---
import { getCollection } from 'astro:content';
import BlogList from '../../../components/BlogList.astro';
import { it } from '../../../i18n/it';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.locale === 'it' && !data.draft);
  const tagMap = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const key = tag.toLowerCase();
      if (!tagMap.has(key)) tagMap.set(key, []);
      tagMap.get(key)!.push(post);
    }
  }
  return Array.from(tagMap.entries()).map(([tagKey, tagPosts]) => {
    const display = tagPosts[0].data.tags.find((t) => t.toLowerCase() === tagKey) ?? tagKey;
    return { params: { tag: tagKey }, props: { posts: tagPosts, tagFilter: display } };
  });
}

const { posts, tagFilter } = Astro.props;
---

<BlogList locale="it" strings={it} posts={posts} tagFilter={tagFilter} />
