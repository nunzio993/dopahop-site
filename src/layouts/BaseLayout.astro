---
import Analytics from '../components/Analytics.astro';

export interface AlternateLocale {
  code: string;
  href: string;
}

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  locale?: 'it' | 'en' | 'es' | 'de' | 'fr';
  alternateLocales?: AlternateLocale[];
  ogType?: 'website' | 'article';
  theme?: 'dark' | 'light';
  noindex?: boolean;
  articleMeta?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    tags?: string[];
  };
}

const {
  title = 'DopaHop — App ADHD gentile',
  description = "DopaHop è l'app ADHD gentile: Pomodoro, routine, mood, farmaci, focus sounds. Niente streak, niente colpa. On-device privacy. 5 lingue.",
  image = '/img/feature-graphic.png',
  canonical,
  locale = 'it',
  alternateLocales: customAlternateLocales,
  ogType = 'website',
  theme = 'dark',
  noindex = false,
  articleMeta,
} = Astro.props;

const siteUrl = 'https://dopahop.app';
const fullCanonical = canonical || new URL(Astro.url.pathname, siteUrl).toString();
const fullImage = image.startsWith('http') ? image : new URL(image, siteUrl).toString();

const alternateLocales: AlternateLocale[] = customAlternateLocales ?? [
  { code: 'it', href: new URL('/', siteUrl).toString() },
  { code: 'en', href: new URL('/en/', siteUrl).toString() },
  { code: 'es', href: new URL('/es/', siteUrl).toString() },
  { code: 'de', href: new URL('/de/', siteUrl).toString() },
  { code: 'fr', href: new URL('/fr/', siteUrl).toString() },
  { code: 'x-default', href: new URL('/', siteUrl).toString() },
];
---
<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/png" href="/img/icon.png" />
  <link rel="canonical" href={fullCanonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content={theme === 'light' ? '#FAFAFA' : '#0F0F23'} />

  {alternateLocales.map(({ code, href }) => {
    const hreflangCode = code === 'x-default' ? 'x-default'
      : code === 'it' ? 'it-IT'
      : code === 'en' ? 'en-US'
      : code === 'es' ? 'es-ES'
      : code === 'de' ? 'de-DE'
      : code === 'fr' ? 'fr-FR'
      : code;
    return <link rel="alternate" hreflang={hreflangCode} href={href} />;
  })}

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={fullCanonical} />
  <meta property="og:image" content={fullImage} />
  <meta property="og:locale" content={locale === 'it' ? 'it_IT' : locale === 'en' ? 'en_US' : locale === 'es' ? 'es_ES' : locale === 'de' ? 'de_DE' : 'fr_FR'} />
  {articleMeta?.publishedTime && <meta property="article:published_time" content={articleMeta.publishedTime} />}
  {articleMeta?.modifiedTime && <meta property="article:modified_time" content={articleMeta.modifiedTime} />}
  {articleMeta?.author && <meta property="article:author" content={articleMeta.author} />}
  {articleMeta?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullImage} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://dopahop.app/#organization",
        "name": "DopaHop",
        "url": "https://dopahop.app",
        "logo": {
          "@type": "ImageObject",
          "url": "https://dopahop.app/img/icon.png",
          "width": 1024,
          "height": 1024,
        },
        "description": "DopaHop è un'app ADHD gentile per Android: Pomodoro, promemoria farmaci, brain dump, focus sounds. Niente streak, niente colpa. Privacy on-device.",
        "foundingDate": "2026-05",
        "founder": { "@id": "https://dopahop.app/about/#person" },
        "address": { "@type": "PostalAddress", "addressCountry": "IT" },
        "areaServed": ["IT", "GB", "US", "ES", "DE", "FR", "AT", "CH"],
        "sameAs": ["https://play.google.com/store/apps/details?id=com.dopahop.android", "https://apps.apple.com/app/id6772196314"],
      },
      {
        "@type": "WebSite",
        "@id": "https://dopahop.app/#website",
        "url": "https://dopahop.app",
        "name": "DopaHop",
        "description": "App ADHD gentile per adulti e blog multilingua su ADHD, neurodivergenza e funzioni esecutive.",
        "publisher": { "@id": "https://dopahop.app/#organization" },
        "inLanguage": ["it", "en", "es", "de", "fr"],
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://dopahop.app/blog/?q={search_term_string}",
          },
          "query-input": "required name=search_term_string",
        },
      },
      {
        "@type": "MobileApplication",
        "name": "DopaHop",
        "operatingSystem": "Android, iOS",
        "applicationCategory": "HealthApplication",
        "description": description,
        "url": "https://dopahop.app",
        "downloadUrl": "https://play.google.com/store/apps/details?id=com.dopahop.android",
        "image": fullImage,
        "publisher": { "@id": "https://dopahop.app/#organization" },
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "EUR",
        },
      },
    ],
  })} />

  <link rel="preload" href="/fonts/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2" as="font" type="font/woff2" crossorigin />
  <style>
    /* Self-hosted fonts (Inter, Instrument Serif, Newsreader) — latin + latin-ext subsets only.
       Replaces external Google Fonts: zero render-block, no third-party request, GDPR-friendly. */
    @font-face{font-family:'Inter';font-style:normal;font-weight:400 800;font-display:swap;src:url(/fonts/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
    @font-face{font-family:'Inter';font-style:normal;font-weight:400 800;font-display:swap;src:url(/fonts/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa25L7SUc.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
    @font-face{font-family:'Instrument Serif';font-style:normal;font-weight:400;font-display:swap;src:url(/fonts/jizBRFtNs2ka5fXjeivQ4LroWlx-6zUTjg.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
    @font-face{font-family:'Instrument Serif';font-style:normal;font-weight:400;font-display:swap;src:url(/fonts/jizBRFtNs2ka5fXjeivQ4LroWlx-6zsTjmbI.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
    @font-face{font-family:'Instrument Serif';font-style:italic;font-weight:400;font-display:swap;src:url(/fonts/jizHRFtNs2ka5fXjeivQ4LroWlx-6zAjjH7M.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
    @font-face{font-family:'Instrument Serif';font-style:italic;font-weight:400;font-display:swap;src:url(/fonts/jizHRFtNs2ka5fXjeivQ4LroWlx-6zAjgn7MsNo.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
    @font-face{font-family:'Newsreader';font-style:normal;font-weight:400 600;font-display:swap;src:url(/fonts/cY9AfjOCX1hbuyalUrK4397yjA.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
    @font-face{font-family:'Newsreader';font-style:normal;font-weight:400 600;font-display:swap;src:url(/fonts/cY9AfjOCX1hbuyalUrK439DyjJBG.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
    @font-face{font-family:'Newsreader';font-style:italic;font-weight:400 500;font-display:swap;src:url(/fonts/cY9CfjOCX1hbuyalUrK439vCjohC.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
    @font-face{font-family:'Newsreader';font-style:italic;font-weight:400 500;font-display:swap;src:url(/fonts/cY9CfjOCX1hbuyalUrK439vCgIhCFpY.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
  </style>

  <link rel="sitemap" href="/sitemap-index.xml" />
</head>
<body class:list={[`theme-${theme}`]}>
  <slot />
  <Analytics locale={locale} />
</body>
</html>

<style is:global>
  @import '../styles/global.css';

  /* ─── Brand color tokens (theme-independent) ─── */
  :root {
    --primary: #FFB703;
    --primary-light: #FFCE4A;
    --primary-dark: #D99E00;
    --secondary: #FF6B6B;
    --tertiary: #4ECDC4;
    --success: #66BB6A;
    --warning: #FFA726;
    --task-decomp: #C7BAFF;

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 20px;
    --radius-xl: 28px;
    --radius-full: 999px;

    --serif: 'Instrument Serif', 'Times New Roman', serif;
    --serif-body: 'Newsreader', 'Iowan Old Style', 'Charter', Georgia, serif;
    --sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  /* ─── DARK theme (default — landing) ─── */
  body.theme-dark {
    --bg: #0F0F23;
    --surface: #1A1A2E;
    --surface-elevated: #232340;

    --ink: #FAFAFA;
    --ink-soft: #BDBDBD;
    --ink-muted: #757575;

    --border: rgba(255, 255, 255, 0.08);
    --border-strong: rgba(255, 255, 255, 0.16);

    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3), 0 2px 8px rgba(0, 0, 0, 0.2);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.35), 0 12px 28px rgba(0, 0, 0, 0.25);
    --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.4), 0 24px 64px rgba(0, 0, 0, 0.35);
    --shadow-brand: 0 8px 24px rgba(255, 183, 3, 0.25);
  }

  /* ─── LIGHT theme (editorial — blog) ─── */
  body.theme-light {
    --bg: #FAF9F6;
    --surface: #FFFFFF;
    --surface-elevated: #F2F0EB;

    --ink: #1A1A1A;
    --ink-soft: #4A4A4A;
    --ink-muted: #8A8A8A;

    --border: rgba(0, 0, 0, 0.08);
    --border-strong: rgba(0, 0, 0, 0.16);

    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04), 0 2px 8px rgba(0, 0, 0, 0.03);
    --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.06), 0 12px 32px rgba(0, 0, 0, 0.05);
    --shadow-lg: 0 8px 36px rgba(0, 0, 0, 0.08), 0 24px 64px rgba(0, 0, 0, 0.06);
    --shadow-brand: 0 8px 24px rgba(255, 183, 3, 0.18);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--ink);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    letter-spacing: -0.011em;
    overflow-x: hidden;
    transition: background 0.2s ease, color 0.2s ease;
  }
  ::selection { background: var(--primary); color: #0F0F23; }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
</style>
