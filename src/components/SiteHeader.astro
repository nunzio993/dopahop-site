---
import type { LandingStrings, Locale } from '../i18n/types';
import Picture from './Picture.astro';

export interface Props {
  locale: Locale;
  strings: LandingStrings;
}

const { locale, strings: t } = Astro.props;

const homePathByLocale: Record<Locale, string> = {
  it: '/',
  en: '/en/',
  es: '/es/',
  de: '/de/',
  fr: '/fr/',
};
const localeLabels: Record<Locale, string> = {
  it: 'IT',
  en: 'EN',
  es: 'ES',
  de: 'DE',
  fr: 'FR',
};
const allLocales: Locale[] = ['it', 'en', 'es', 'de', 'fr'];

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.dopahop.android';
const homeHref = homePathByLocale[locale];
const blogHref = `${homeHref}blog/`.replace(/\/+/g, '/');
---

<header id="header">
  <div class="container">
    <div class="header-inner">
      <a href={homeHref} class="logo">
        <Picture src="/img/icon.png" alt="DopaHop" class="logo-img" width={34} height={34} loading="eager" fetchpriority="high" />
        DopaHop
      </a>
      <nav class="nav">
        <a href={`${homeHref}#perche`}>{t.nav.perche}</a>
        <a href={`${homeHref}#cosa-fa`}>{t.nav.cosaFa}</a>
        <a href={`${homeHref}#widget`}>{t.nav.widget}</a>
        <a href={blogHref}>{t.nav.blog}</a>
        <a href={`${homeHref}#privacy`}>{t.nav.privacy}</a>
        <a href={`${homeHref}#faq`}>{t.nav.faq}</a>
      </nav>
      <div class="header-right">
        <div class="lang-switcher" aria-label={t.langSwitcher.label}>
          {allLocales.map((lc) => (
            <a
              href={homePathByLocale[lc]}
              class:list={['lang-link', { active: lc === locale }]}
              hreflang={lc === 'it' ? 'it-IT' : lc === 'en' ? 'en-US' : lc === 'es' ? 'es-ES' : lc === 'de' ? 'de-DE' : 'fr-FR'}
              aria-current={lc === locale ? 'page' : undefined}
            >
              {localeLabels[lc]}
            </a>
          ))}
        </div>
        <a href={playStoreUrl} class="header-cta">
          {t.nav.download}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .header-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
  }
  .lang-link {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 5px 9px;
    border-radius: var(--radius-full);
    color: var(--ink-muted);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .lang-link:hover { color: var(--ink); }
  .lang-link.active {
    background: var(--primary);
    color: var(--bg);
  }
  @media (max-width: 760px) {
    .lang-switcher { gap: 0; padding: 3px; }
    .lang-link { padding: 4px 7px; font-size: 10px; }
    .header-right { gap: 8px; }
    .header-cta { padding: 8px 14px; font-size: 13px; }
  }

  /* When body is light themed (blog post), header stays dark — force light text */
  :global(body.theme-light) header {
    background: rgba(15, 15, 35, 0.92);
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }
  :global(body.theme-light) .logo { color: #FAFAFA; }
  :global(body.theme-light) nav.nav a { color: #BDBDBD; }
  :global(body.theme-light) nav.nav a:hover { color: #FAFAFA; }
  :global(body.theme-light) .lang-switcher {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
  }
  :global(body.theme-light) .lang-link { color: rgba(255, 255, 255, 0.5); }
  :global(body.theme-light) .lang-link:hover { color: #FAFAFA; }
  :global(body.theme-light) .lang-link.active {
    background: var(--primary);
    color: #0F0F23;
  }
  :global(body.theme-light) .header-cta {
    background: var(--primary);
    color: #0F0F23;
  }
</style>
