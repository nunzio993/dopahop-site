---
import type { CollectionEntry } from 'astro:content';
import type { LandingStrings, Locale } from '../i18n/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';

export interface Props {
  locale: Locale;
  strings: LandingStrings;
  post: CollectionEntry<'blog'>;
  translations: CollectionEntry<'blog'>[];
}

const { locale, strings: t, post, translations } = Astro.props;

const homePathByLocale: Record<Locale, string> = {
  it: '/',
  en: '/en/',
  es: '/es/',
  de: '/de/',
  fr: '/fr/',
};
const homeHref = homePathByLocale[locale];
const blogHref = `${homeHref}blog/`.replace(/\/+/g, '/');

function cleanSlugFor(p: CollectionEntry<'blog'>): string {
  return p.slug.replace(new RegExp(`^${p.data.locale}/`), '');
}

function postUrl(p: CollectionEntry<'blog'>): string {
  const prefix = homePathByLocale[p.data.locale];
  return `${prefix}blog/${cleanSlugFor(p)}/`.replace(/\/+/g, '/');
}

const cleanSlug = cleanSlugFor(post);
const siteUrl = 'https://dopahop.app';
const canonical = new URL(`${blogHref}${cleanSlug}/`.replace(/\/+/g, '/'), siteUrl).toString();
const fullCoverUrl = post.data.cover
  ? (post.data.cover.startsWith('http') ? post.data.cover : new URL(post.data.cover, siteUrl).toString())
  : new URL('/img/feature-graphic.png', siteUrl).toString();

const wordCount = post.body.split(/\s+/).filter(Boolean).length;
const minRead = Math.max(1, Math.round(wordCount / 200));

const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const alternateLocales = (() => {
  const entries: { code: string; href: string }[] = [];
  const allInGroup = [post, ...translations];
  for (const p of allInGroup) {
    entries.push({ code: p.data.locale, href: new URL(postUrl(p), siteUrl).toString() });
  }
  const itEntry = entries.find((e) => e.code === 'it');
  if (itEntry) entries.push({ code: 'x-default', href: itEntry.href });
  return entries;
})();

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: fullCoverUrl,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: post.data.author },
  publisher: {
    '@type': 'Organization',
    name: 'DopaHop',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/img/icon.png', siteUrl).toString(),
    },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  inLanguage: locale,
  keywords: post.data.tags.join(', '),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'DopaHop',
      item: new URL(homeHref, siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.nav.blog,
      item: new URL(blogHref, siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: canonical,
    },
  ],
};
---

<BaseLayout
  title={`${post.data.title} — DopaHop`}
  description={post.data.description}
  locale={locale}
  canonical={canonical}
  image={post.data.cover ?? '/img/feature-graphic.png'}
  alternateLocales={alternateLocales}
  ogType="article"
  articleMeta={{
    publishedTime: post.data.pubDate.toISOString(),
    modifiedTime: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: post.data.author,
    tags: post.data.tags,
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" id="reading-progress-bar"></div>
  </div>

  <div class="ambient">
    <div class="glow glow-1"></div>
    <div class="glow glow-3"></div>
  </div>

  <SiteHeader locale={locale} strings={t} showAnchorNav={false} />

  <main>
    <article class="post">
      <div class:list={['post-hero', { 'has-cover': !!post.data.cover }]}>
        {post.data.cover && (
          <div class="post-hero-bg" aria-hidden="true">
            <img src={post.data.cover} alt="" />
          </div>
        )}
        <div class="container container-narrow">
          <nav class="breadcrumb reveal" aria-label="Breadcrumb">
            <a href={homeHref}>DopaHop</a>
            <span aria-hidden="true">›</span>
            <a href={blogHref}>{t.nav.blog}</a>
            <span aria-hidden="true">›</span>
            <span aria-current="page">{post.data.title}</span>
          </nav>

          <div class="post-hero-inner reveal">
            {post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.map((tag) => (
                  <span class="post-tag">{tag}</span>
                ))}
              </div>
            )}
            <h1 class="post-title">{post.data.title}</h1>
            <p class="post-description">{post.data.description}</p>
            <div class="post-meta">
              <span class="post-meta-item">
                <span class="post-meta-icon" aria-hidden="true">✎</span>
                {t.blog.by} <strong>{post.data.author}</strong>
              </span>
              <span class="post-meta-divider" aria-hidden="true">·</span>
              <span class="post-meta-item">
                <span class="post-meta-icon" aria-hidden="true">📅</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFormatter.format(post.data.pubDate)}
                </time>
              </span>
              <span class="post-meta-divider" aria-hidden="true">·</span>
              <span class="post-meta-item">
                <span class="post-meta-icon" aria-hidden="true">⏱</span>
                {minRead} {t.blog.minRead}
              </span>
            </div>
          </div>
        </div>
      </div>

      {post.data.cover && (
        <div class="post-cover-section reveal">
          <div class="container container-narrow">
            <div class="post-cover">
              <img src={post.data.cover} alt={post.data.title} />
            </div>
          </div>
        </div>
      )}

      <div class="post-content-section">
        <div class="container container-narrow">
          <div class="post-body reveal">
            <slot />
          </div>

          {translations.length > 0 && (
            <aside class="post-translations reveal" aria-label="Translations">
              <span class="post-translations-label">{t.langSwitcher.label}</span>
              <div class="post-translations-links">
                {translations.map((tr) => (
                  <a href={postUrl(tr)} hreflang={tr.data.locale} class="post-translation-link">
                    {tr.data.locale.toUpperCase()}
                  </a>
                ))}
              </div>
            </aside>
          )}

          <div class="post-author-card reveal">
            <div class="post-author-avatar" aria-hidden="true">
              {post.data.author.split(' ').map((w) => w[0]).join('').slice(0, 2)}
            </div>
            <div>
              <div class="post-author-label">{t.blog.by}</div>
              <div class="post-author-name">{post.data.author}</div>
            </div>
          </div>

          <div class="post-back reveal">
            <a href={blogHref} class="post-back-link">{t.blog.backToBlog}</a>
          </div>
        </div>
      </div>
    </article>
  </main>

  <SiteFooter locale={locale} strings={t} />

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

    const header = document.getElementById('header');
    if (header) {
      window.addEventListener('scroll', () => {
        header.classList.toggle('scrolled', window.scrollY > 8);
      });
    }

    // Reading progress bar
    const progressBar = document.getElementById('reading-progress-bar');
    const article = document.querySelector('.post-body');
    if (progressBar && article) {
      const update = () => {
        const rect = article.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        const scrolled = -rect.top;
        const ratio = total > 0 ? Math.min(Math.max(scrolled / total, 0), 1) : 0;
        progressBar.style.transform = `scaleX(${ratio})`;
      };
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }
  </script>
</BaseLayout>

<style>
  /* ── READING PROGRESS BAR ── */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.04);
    z-index: 100;
    pointer-events: none;
  }
  .reading-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--primary) 0%, var(--primary-light) 60%, var(--tertiary) 100%);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.05s linear;
  }

  /* ── POST HERO ── */
  .post {
    position: relative;
  }
  .post-hero {
    position: relative;
    padding: 64px 0 32px;
    overflow: hidden;
  }
  .post-hero.has-cover {
    padding-bottom: 56px;
  }
  .post-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .post-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(56px) saturate(120%);
    opacity: 0.18;
    transform: scale(1.15);
  }
  .post-hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 15, 35, 0.55) 0%, var(--bg) 100%);
  }
  .post-hero .container {
    position: relative;
    z-index: 1;
  }

  /* ── BREADCRUMB ── */
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 13px;
    color: var(--ink-muted);
    margin-bottom: 32px;
  }
  .breadcrumb a {
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }
  .breadcrumb a:hover { color: var(--primary); }
  .breadcrumb span[aria-current] {
    color: var(--ink);
    max-width: 320px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── POST HEADER CONTENT ── */
  .post-hero-inner {
    max-width: 760px;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
  }
  .post-tag {
    font-size: 11px;
    font-weight: 700;
    padding: 5px 13px;
    border-radius: var(--radius-full);
    background: rgba(255, 183, 3, 0.14);
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .post-title {
    font-size: clamp(32px, 5.4vw, 56px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.04;
    margin-bottom: 22px;
    color: var(--ink);
  }
  .post-description {
    font-size: clamp(17px, 2vw, 21px);
    color: var(--ink-soft);
    line-height: 1.5;
    margin-bottom: 28px;
    max-width: 660px;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13px;
    color: var(--ink-muted);
    align-items: center;
  }
  .post-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .post-meta-icon {
    font-size: 13px;
    opacity: 0.8;
    line-height: 1;
  }
  .post-meta strong {
    color: var(--ink);
    font-weight: 600;
  }
  .post-meta-divider { color: var(--ink-muted); opacity: 0.5; }

  /* ── COVER ── */
  .post-cover-section {
    padding: 0 0 24px;
  }
  .post-cover {
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    margin-top: -24px;
  }
  .post-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── BODY (editorial: serif + generous spacing) ── */
  .post-content-section {
    padding: 32px 0 96px;
  }
  .post-body {
    font-family: var(--serif-body);
    font-size: 20px;
    color: var(--ink);
    line-height: 1.75;
    letter-spacing: -0.003em;
  }
  .post-body :global(p:first-of-type::first-letter) {
    font-family: var(--serif);
    font-size: 4.2em;
    font-style: italic;
    float: left;
    line-height: 0.85;
    padding: 0.05em 0.15em 0 0;
    margin: 0.1em 0.05em 0 0;
    color: var(--primary);
  }
  .post-body :global(h2) {
    font-family: var(--sans);
    font-size: clamp(24px, 3.4vw, 30px);
    font-weight: 700;
    letter-spacing: -0.022em;
    margin-top: 64px;
    margin-bottom: 18px;
    color: var(--ink);
    line-height: 1.22;
    position: relative;
  }
  .post-body :global(h2)::before {
    content: '';
    position: absolute;
    left: -20px;
    top: 0.4em;
    bottom: 0.4em;
    width: 3px;
    background: var(--primary);
    border-radius: 2px;
  }
  .post-body :global(h3) {
    font-family: var(--sans);
    font-size: clamp(18px, 2.4vw, 21px);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-top: 40px;
    margin-bottom: 14px;
    color: var(--ink);
    line-height: 1.3;
  }
  .post-body :global(p) {
    margin-bottom: 26px;
    color: var(--ink);
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin-bottom: 22px;
    padding-left: 26px;
    color: var(--ink);
    opacity: 0.92;
  }
  .post-body :global(li) {
    margin-bottom: 10px;
    line-height: 1.65;
  }
  .post-body :global(li)::marker {
    color: var(--primary);
  }
  .post-body :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }
  .post-body :global(em) {
    font-style: italic;
  }
  .post-body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--primary);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.15s ease, color 0.15s ease;
  }
  .post-body :global(a:hover) {
    color: var(--primary-dark);
    text-decoration-color: var(--primary-dark);
  }
  .post-body :global(blockquote) {
    border-left: 3px solid var(--primary);
    padding: 6px 28px;
    margin: 36px 0;
    color: var(--ink);
    font-style: italic;
    font-size: 1.1em;
    line-height: 1.55;
    opacity: 0.85;
  }
  .post-body :global(code) {
    background: var(--surface-elevated);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-size: 0.88em;
    color: var(--primary);
    font-family: 'SFMono-Regular', Consolas, monospace;
  }
  .post-body :global(pre) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    overflow-x: auto;
    margin-bottom: 26px;
    font-size: 14px;
  }
  .post-body :global(pre code) {
    background: transparent;
    padding: 0;
    color: var(--ink);
  }
  .post-body :global(img) {
    border-radius: var(--radius-md);
    margin: 28px 0;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
  }
  .post-body :global(hr) {
    border: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
    margin: 48px 0;
  }

  /* ── TRANSLATIONS ── */
  .post-translations {
    margin-top: 64px;
    padding: 16px 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    font-size: 13px;
  }
  .post-translations-label {
    color: var(--ink-muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 11px;
  }
  .post-translations-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .post-translation-link {
    font-weight: 700;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    background: var(--surface-elevated);
    color: var(--ink-soft);
    transition: color 0.15s ease, background 0.15s ease;
    letter-spacing: 0.04em;
  }
  .post-translation-link:hover {
    color: var(--bg);
    background: var(--primary);
  }

  /* ── AUTHOR CARD ── */
  .post-author-card {
    margin-top: 40px;
    padding: 22px 24px;
    display: flex;
    align-items: center;
    gap: 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .post-author-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    display: grid;
    place-items: center;
    font-weight: 800;
    color: var(--bg);
    font-size: 18px;
    flex-shrink: 0;
    letter-spacing: -0.02em;
  }
  .post-author-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    font-weight: 700;
    margin-bottom: 2px;
  }
  .post-author-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  /* ── BACK LINK ── */
  .post-back {
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .post-back-link {
    color: var(--primary);
    font-weight: 700;
    font-size: 15px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: gap 0.2s ease;
  }
  .post-back-link:hover { gap: 12px; }

  /* ── RESPONSIVE ── */
  @media (max-width: 720px) {
    .post-hero { padding: 40px 0 24px; }
    .post-body :global(h2)::before { left: -12px; width: 2px; }
    .post-body { font-size: 18px; }
    .post-body :global(p:first-of-type::first-letter) { font-size: 3.6em; }
  }
</style>
