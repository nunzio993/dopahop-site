---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import type { LandingStrings, Locale } from '../i18n/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Picture from './Picture.astro';
import {
  AUTHOR_NAME,
  AUTHOR_PHOTO,
  AUTHOR_LINKEDIN,
  AUTHOR_BIO_SHORT,
  AUTHOR_ROLE,
  authorAboutUrl,
  authorPersonSchema,
} from '../data/author';

export interface Props {
  locale: Locale;
  strings: LandingStrings;
  post: CollectionEntry<'blog'>;
  translations: CollectionEntry<'blog'>[];
  headings?: MarkdownHeading[];
}

const { locale, strings: t, post, translations, headings = [] } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2);

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.dopahop.android';

const allLocalePosts = await getCollection('blog', ({ data, slug }) =>
  data.locale === locale && !data.draft && slug !== post.slug && data.pubDate <= new Date(),
);
const currentTags = new Set(post.data.tags.map((tag) => tag.toLowerCase()));
const related = allLocalePosts
  .map((p) => ({
    post: p,
    overlap: p.data.tags.filter((tag) => currentTags.has(tag.toLowerCase())).length,
  }))
  .filter((r) => r.overlap > 0)
  .sort((a, b) => {
    if (b.overlap !== a.overlap) return b.overlap - a.overlap;
    return b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime();
  })
  .slice(0, 3)
  .map((r) => r.post);

const homePathByLocale: Record<Locale, string> = {
  it: '/',
  en: '/en/',
  es: '/es/',
  de: '/de/',
  fr: '/fr/',
};
const homeHref = homePathByLocale[locale];
const blogHref = `${homeHref}blog/`.replace(/\/+/g, '/');

function cleanSlugFor(p: CollectionEntry<'blog'>): string {
  return p.slug.replace(new RegExp(`^${p.data.locale}/`), '');
}

function postUrl(p: CollectionEntry<'blog'>): string {
  const prefix = homePathByLocale[p.data.locale];
  return `${prefix}blog/${cleanSlugFor(p)}/`.replace(/\/+/g, '/');
}

function tagUrl(tag: string): string {
  return `${blogHref}tag/${encodeURIComponent(tag.toLowerCase())}/`.replace(/\/+/g, '/');
}

const cleanSlug = cleanSlugFor(post);
const siteUrl = 'https://dopahop.app';
const canonical = new URL(`${blogHref}${cleanSlug}/`.replace(/\/+/g, '/'), siteUrl).toString();
const fullCoverUrl = post.data.cover
  ? (post.data.cover.startsWith('http') ? post.data.cover : new URL(post.data.cover, siteUrl).toString())
  : new URL('/img/feature-graphic.png', siteUrl).toString();

const wordCount = post.body.split(/\s+/).filter(Boolean).length;
const minRead = Math.max(1, Math.round(wordCount / 200));

const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const alternateLocales = (() => {
  const entries: { code: string; href: string }[] = [];
  const allInGroup = [post, ...translations];
  for (const p of allInGroup) {
    entries.push({ code: p.data.locale, href: new URL(postUrl(p), siteUrl).toString() });
  }
  const itEntry = entries.find((e) => e.code === 'it');
  if (itEntry) entries.push({ code: 'x-default', href: itEntry.href });
  return entries;
})();

const aboutHref = authorAboutUrl(locale);
const isOwnAuthor = post.data.author === AUTHOR_NAME;
const authorSchema = isOwnAuthor
  ? authorPersonSchema(locale, siteUrl)
  : { '@type': 'Person', name: post.data.author };

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: fullCoverUrl,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: authorSchema,
  publisher: { '@id': `${siteUrl}/#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  inLanguage: locale,
  keywords: post.data.tags.join(', '),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'DopaHop',
      item: new URL(homeHref, siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.nav.blog,
      item: new URL(blogHref, siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: canonical,
    },
  ],
};

// Extract FAQ section from markdown body and emit FAQPage schema for rich snippets.
// Looks for the localized FAQ H2 heading, then takes the H3 questions + bodies underneath.
const faqHeadings: Record<Locale, RegExp> = {
  it: /Domande frequenti|FAQ/i,
  en: /Frequently Asked Questions|FAQ/i,
  es: /Preguntas frecuentes|FAQ/i,
  de: /Häufige Fragen|FAQ/i,
  fr: /Foire aux questions|Questions fréquentes|FAQ/i,
};

function extractFAQ(body: string, lc: Locale): { q: string; a: string }[] {
  const heading = faqHeadings[lc];
  const sectionMatch = body.match(new RegExp(`^##\\s+(?:${heading.source})\\s*$([\\s\\S]*?)(?=^##\\s|$(?![\\s\\S]))`, 'mi'));
  if (!sectionMatch) return [];
  const sectionBody = sectionMatch[1];
  const items: { q: string; a: string }[] = [];
  const qaRegex = /^###\s+(.+?)\s*$\n+([\s\S]*?)(?=^###\s|^##\s|$(?![\s\S]))/gm;
  let m: RegExpExecArray | null;
  while ((m = qaRegex.exec(sectionBody)) !== null) {
    const q = m[1].trim();
    const a = m[2]
      .trim()
      .replace(/\n{2,}/g, ' ')
      .replace(/\n/g, ' ')
      .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
      .replace(/[*_`]/g, '')
      .replace(/\s+/g, ' ')
      .trim();
    if (q && a) items.push({ q, a });
  }
  return items;
}

const faqItems = extractFAQ(post.body, locale);
const faqSchema = faqItems.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((it) => ({
        '@type': 'Question',
        name: it.q,
        acceptedAnswer: { '@type': 'Answer', text: it.a },
      })),
    }
  : null;
---

<BaseLayout
  title={`${post.data.title} — DopaHop`}
  description={post.data.description}
  locale={locale}
  canonical={canonical}
  image={post.data.cover ?? '/img/feature-graphic.png'}
  alternateLocales={alternateLocales}
  ogType="article"
  theme="light"
  articleMeta={{
    publishedTime: post.data.pubDate.toISOString(),
    modifiedTime: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: post.data.author,
    tags: post.data.tags,
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" id="reading-progress-bar"></div>
  </div>

  <div class="ambient">
    <div class="glow glow-1"></div>
    <div class="glow glow-3"></div>
  </div>

  <SiteHeader locale={locale} strings={t} />

  <main>
    <article class="post">
      <div class:list={['post-hero', { 'has-cover': !!post.data.cover }]}>
        {post.data.cover && (
          <div class="post-hero-bg" aria-hidden="true">
            <img src={post.data.cover} alt="" />
          </div>
        )}
        <div class="container container-narrow">
          <nav class="breadcrumb reveal" aria-label="Breadcrumb">
            <a href={homeHref}>DopaHop</a>
            <span aria-hidden="true">›</span>
            <a href={blogHref}>{t.nav.blog}</a>
            <span aria-hidden="true">›</span>
            <span aria-current="page">{post.data.title}</span>
          </nav>

          <div class="post-hero-inner reveal">
            {post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.map((tag) => (
                  <a href={tagUrl(tag)} class="post-tag">{tag}</a>
                ))}
              </div>
            )}
            <h1 class="post-title">{post.data.title}</h1>
            <p class="post-description">{post.data.description}</p>
            <div class="post-meta">
              <span class="post-meta-item">
                <span class="post-meta-icon" aria-hidden="true">✎</span>
                {t.blog.by}{' '}
                {isOwnAuthor ? (
                  <a href={aboutHref} class="post-meta-author-link"><strong>{post.data.author}</strong></a>
                ) : (
                  <strong>{post.data.author}</strong>
                )}
              </span>
              <span class="post-meta-divider" aria-hidden="true">·</span>
              <span class="post-meta-item">
                <span class="post-meta-icon" aria-hidden="true">📅</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFormatter.format(post.data.pubDate)}
                </time>
              </span>
              <span class="post-meta-divider" aria-hidden="true">·</span>
              <span class="post-meta-item">
                <span class="post-meta-icon" aria-hidden="true">⏱</span>
                {minRead} {t.blog.minRead}
              </span>
            </div>
          </div>
        </div>
      </div>

      {post.data.cover && (
        <div class="post-cover-section reveal">
          <div class="container container-narrow">
            <div class="post-cover">
              <img src={post.data.cover} alt={post.data.title} />
            </div>
          </div>
        </div>
      )}

      <div class="post-content-section">
        <div class="container post-content-grid">
          <div class="post-content-main">
          <div class="post-body">
            <slot />
          </div>

          <aside class="post-inline-cta" id="post-inline-cta" hidden aria-label={t.blog.appCardTitle}>
            <Picture src="/img/icon.png" alt="" width={56} height={56} class="post-inline-cta-icon" loading="lazy" />
            <div class="post-inline-cta-text">
              <p class="post-inline-cta-title">{t.blog.appCardTitle}</p>
              <p class="post-inline-cta-subtitle">{t.blog.appCardSubtitle}</p>
            </div>
            <a href={playStoreUrl} class="post-inline-cta-btn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="14" height="14"><path d="M3.6 1.5L13.5 12 3.6 22.5c-.6-.4-1-1-1-1.7V3.2c0-.7.4-1.3 1-1.7zM14.6 13.1l2.5 2.6-12.4 7.1 9.9-9.7zm0-2.2l-9.9-9.7 12.4 7.1-2.5 2.6zm6.6.7c.8.4 1.3 1.2 1.3 2.1 0 .9-.5 1.7-1.3 2.1l-2.7 1.6-2.8-2.7 2.8-2.7 2.7 1.6z"/></svg>
              {t.blog.appCardCta}
            </a>
          </aside>

          {related.length > 0 && (
            <section class="post-related reveal" aria-label={t.blog.relatedPosts}>
              <h2 class="post-related-title">{t.blog.relatedPosts}</h2>
              <ul class="post-related-list">
                {related.map((rp) => {
                  const wc = rp.body.split(/\s+/).filter(Boolean).length;
                  const minR = Math.max(1, Math.round(wc / 200));
                  return (
                    <li class="post-related-item">
                      <a href={postUrl(rp)} class="post-related-link">
                        <h3 class="post-related-card-title">{rp.data.title}</h3>
                        <p class="post-related-excerpt">{rp.data.excerpt ?? rp.data.description}</p>
                        <div class="post-related-meta">
                          <time datetime={rp.data.pubDate.toISOString()}>{dateFormatter.format(rp.data.pubDate)}</time>
                          <span aria-hidden="true">·</span>
                          <span>{minR} {t.blog.minRead}</span>
                        </div>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          )}

          {translations.length > 0 && (
            <aside class="post-translations reveal" aria-label="Translations">
              <span class="post-translations-label">{t.langSwitcher.label}</span>
              <div class="post-translations-links">
                {translations.map((tr) => (
                  <a href={postUrl(tr)} hreflang={tr.data.locale === 'it' ? 'it-IT' : tr.data.locale === 'en' ? 'en-US' : tr.data.locale === 'es' ? 'es-ES' : tr.data.locale === 'de' ? 'de-DE' : 'fr-FR'} class="post-translation-link">
                    {tr.data.locale.toUpperCase()}
                  </a>
                ))}
              </div>
            </aside>
          )}

          <div class="post-author-card reveal">
            {isOwnAuthor ? (
              <Picture
                src={AUTHOR_PHOTO}
                alt={AUTHOR_NAME}
                class="post-author-photo"
                width={64}
                height={64}
                loading="lazy"
              />
            ) : (
              <div class="post-author-avatar" aria-hidden="true">
                {post.data.author.split(' ').map((w) => w[0]).join('').slice(0, 2)}
              </div>
            )}
            <div class="post-author-text">
              <div class="post-author-label">{t.blog.by}</div>
              <div class="post-author-name">
                {isOwnAuthor ? (
                  <a href={aboutHref}>{post.data.author}</a>
                ) : (
                  post.data.author
                )}
              </div>
              {isOwnAuthor && (
                <>
                  <p class="post-author-role">{AUTHOR_ROLE[locale]}</p>
                  <p class="post-author-bio">{AUTHOR_BIO_SHORT[locale]}</p>
                  <div class="post-author-links">
                    <a href={aboutHref} class="post-author-link">{t.blog.authorReadMore}</a>
                    <a
                      href={AUTHOR_LINKEDIN}
                      rel="me noopener"
                      target="_blank"
                      class="post-author-link post-author-link-ghost"
                    >
                      {t.blog.authorLinkedin} ↗
                    </a>
                  </div>
                </>
              )}
            </div>
          </div>

          <div class="post-back reveal">
            <a href={blogHref} class="post-back-link">{t.blog.backToBlog}</a>
          </div>
          </div>

          {tocHeadings.length > 0 && (
            <aside class="post-toc" aria-label={t.blog.tocLabel}>
              <nav>
                <p class="post-toc-title">{t.blog.tocLabel}</p>
                <ul class="post-toc-list">
                  {tocHeadings.map((h) => (
                    <li class="post-toc-item">
                      <a href={`#${h.slug}`} data-toc-id={h.slug} class="post-toc-link">{h.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            </aside>
          )}
        </div>
      </div>
    </article>
  </main>

  <SiteFooter locale={locale} strings={t} />

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

    const header = document.getElementById('header');
    if (header) {
      window.addEventListener('scroll', () => {
        header.classList.toggle('scrolled', window.scrollY > 8);
      });
    }

    // Inline app CTA: move it inside .post-body before a mid-article H2
    const cta = document.getElementById('post-inline-cta');
    const body = document.querySelector('.post-body');
    if (cta && body) {
      const h2s = body.querySelectorAll(':scope > h2');
      if (h2s.length >= 2) {
        const idx = Math.floor(h2s.length / 2);
        body.insertBefore(cta, h2s[idx]);
        cta.hidden = false;
      } else {
        cta.remove();
      }
    }

    // TOC scroll-spy: highlight the link matching the H2 currently in view
    const tocLinks = document.querySelectorAll('.post-toc .post-toc-link[data-toc-id]');
    if (tocLinks.length > 0 && body) {
      const tocMap = {};
      tocLinks.forEach((a) => { tocMap[a.dataset.tocId] = a; });
      const tocHeadings = body.querySelectorAll(':scope > h2[id]');
      if (tocHeadings.length > 0) {
        const setActive = (id) => {
          tocLinks.forEach((a) => a.classList.toggle('is-active', a.dataset.tocId === id));
        };
        const tocObserver = new IntersectionObserver((entries) => {
          // Pick the first intersecting heading (topmost in the band)
          const visible = entries.filter((e) => e.isIntersecting);
          if (visible.length > 0) {
            visible.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
            setActive(visible[0].target.id);
          }
        }, { rootMargin: '-15% 0px -75% 0px', threshold: 0 });
        tocHeadings.forEach((h) => tocObserver.observe(h));
        // Initialize: first heading active
        setActive(tocHeadings[0].id);
      }
    }

    // Reading progress bar
    const progressBar = document.getElementById('reading-progress-bar');
    const article = document.querySelector('.post-body');
    if (progressBar && article) {
      const update = () => {
        const rect = article.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        const scrolled = -rect.top;
        const ratio = total > 0 ? Math.min(Math.max(scrolled / total, 0), 1) : 0;
        progressBar.style.transform = `scaleX(${ratio})`;
      };
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }
  </script>
</BaseLayout>

<style>
  /* ── READING PROGRESS BAR ── */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.04);
    z-index: 100;
    pointer-events: none;
  }
  .reading-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--primary) 0%, var(--primary-light) 60%, var(--tertiary) 100%);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.05s linear;
  }

  /* ── POST HERO (dark island sopra body light) ── */
  .post {
    position: relative;
  }
  .post-hero {
    position: relative;
    padding: 56px 0 72px;
    overflow: hidden;
    /* Hero scuro deliberato — "drop into reading" verso body light */
    background: linear-gradient(180deg, #0F0F23 0%, #15152E 60%, #1A1A2E 100%);
    color: #FAFAFA;
  }
  .post-hero.has-cover {
    padding-bottom: 96px;
  }
  .post-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .post-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(56px) saturate(140%);
    opacity: 0.32;
    transform: scale(1.15);
  }
  .post-hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 15, 35, 0.55) 0%, #1A1A2E 100%);
  }
  .post-hero .container {
    position: relative;
    z-index: 1;
  }
  /* Force light text inside hero, regardless of body theme */
  .post-hero .breadcrumb { color: rgba(255, 255, 255, 0.5); }
  .post-hero .breadcrumb a { color: rgba(255, 255, 255, 0.75); }
  .post-hero .breadcrumb a:hover { color: var(--primary); }
  .post-hero .breadcrumb span[aria-current] { color: rgba(255, 255, 255, 0.95); }
  .post-hero .post-title { color: #FAFAFA; }
  .post-hero .post-description { color: rgba(255, 255, 255, 0.72); }
  .post-hero .post-meta { color: rgba(255, 255, 255, 0.55); }
  .post-hero .post-meta strong { color: rgba(255, 255, 255, 0.92); }
  .post-hero .post-meta-divider { color: rgba(255, 255, 255, 0.3); }
  .post-hero .post-tag {
    background: rgba(255, 183, 3, 0.18);
    color: #FFCE4A;
  }

  /* ── BREADCRUMB ── */
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 13px;
    color: var(--ink-muted);
    margin-bottom: 32px;
  }
  .breadcrumb a {
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }
  .breadcrumb a:hover { color: var(--primary); }
  .breadcrumb span[aria-current] {
    color: var(--ink);
    max-width: 320px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── POST HEADER CONTENT ── */
  .post-hero-inner {
    max-width: 760px;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
  }
  .post-tag {
    font-size: 11px;
    font-weight: 700;
    padding: 5px 13px;
    border-radius: var(--radius-full);
    background: rgba(255, 183, 3, 0.14);
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: inline-block;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  a.post-tag:hover {
    background: rgba(255, 183, 3, 0.24);
    transform: translateY(-1px);
  }
  .post-title {
    font-size: clamp(32px, 5.4vw, 56px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.04;
    margin-bottom: 22px;
    color: var(--ink);
  }
  .post-description {
    font-size: clamp(17px, 2vw, 21px);
    color: var(--ink-soft);
    line-height: 1.5;
    margin-bottom: 28px;
    max-width: 660px;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13px;
    color: var(--ink-muted);
    align-items: center;
  }
  .post-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .post-meta-icon {
    font-size: 13px;
    opacity: 0.8;
    line-height: 1;
  }
  .post-meta strong {
    color: var(--ink);
    font-weight: 600;
  }
  .post-meta-divider { color: var(--ink-muted); opacity: 0.5; }

  /* ── COVER (overlapping into light body) ── */
  .post-cover-section {
    padding: 0 0 24px;
  }
  .post-cover {
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    margin-top: -56px;
    position: relative;
    z-index: 2;
  }
  .post-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── BODY (editorial: serif + generous spacing) ── */
  .post-content-section {
    padding: 32px 0 96px;
    background: var(--bg);
    position: relative;
    z-index: 2;
