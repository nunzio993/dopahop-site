---
import type { LandingStrings, Locale } from '../i18n/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Picture from './Picture.astro';

export interface Props {
  locale: Locale;
  strings: LandingStrings;
}

const { locale, strings: t } = Astro.props;

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.dopahop.android';
const appStoreUrl = 'https://apps.apple.com/app/id6772196314';
const privacyPolicyUrl = 'https://nunzio993.github.io/dopahop-assets/privacy-policy.html';
const playBadgeSrc = `/img/store-badges/google-play-${locale}.png`;
const appStoreBadgeSrc = `/img/store-badges/app-store-${locale}.svg`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a.join(' ').replace(/<[^>]+>/g, ''),
    },
  })),
};
---

<BaseLayout title={t.meta.title} description={t.meta.description} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <symbol id="hop-full" viewBox="0 0 220 260">
        <ellipse cx="80" cy="48" rx="10" ry="36" fill="#FFB703" stroke="#2A2A2A" stroke-width="2.5" transform="rotate(-12 80 48)"/>
        <ellipse cx="80" cy="56" rx="4" ry="24" fill="#FFB6C1" transform="rotate(-12 80 56)"/>
        <ellipse cx="124" cy="42" rx="10" ry="38" fill="#FFB703" stroke="#2A2A2A" stroke-width="2.5"/>
        <ellipse cx="124" cy="50" rx="4" ry="26" fill="#FFB6C1"/>
        <ellipse cx="102" cy="180" rx="50" ry="55" fill="#FFB703" stroke="#2A2A2A" stroke-width="2.5"/>
        <circle cx="102" cy="108" r="46" fill="#FFB703" stroke="#2A2A2A" stroke-width="2.5"/>
        <path d="M 56 165 Q 60 155 75 152 L 75 215 Q 60 215 54 200 Z" fill="#E74C3C" stroke="#2A2A2A" stroke-width="2.5"/>
        <path d="M 148 165 Q 144 155 129 152 L 129 215 Q 144 215 150 200 Z" fill="#E74C3C" stroke="#2A2A2A" stroke-width="2.5"/>
        <path d="M 75 152 L 129 152 L 129 215 L 75 215 Z" fill="#E74C3C" stroke="#2A2A2A" stroke-width="2.5"/>
        <polygon points="102,170 107,182 119,182 110,190 113,202 102,194 91,202 94,190 85,182 97,182" fill="#FFD700" stroke="#2A2A2A" stroke-width="1.5"/>
        <path d="M 78 96 Q 86 92 94 96" stroke="#2A2A2A" stroke-width="2" fill="none" stroke-linecap="round"/>
        <path d="M 110 96 Q 118 92 126 96" stroke="#2A2A2A" stroke-width="2" fill="none" stroke-linecap="round"/>
        <path d="M 75 112 Q 86 104 97 112" stroke="#2A2A2A" stroke-width="2.6" fill="none" stroke-linecap="round"/>
        <path d="M 107 112 Q 118 104 129 112" stroke="#2A2A2A" stroke-width="2.6" fill="none" stroke-linecap="round"/>
        <ellipse cx="74" cy="128" rx="8" ry="4" fill="#FFB6C1" opacity="0.7"/>
        <ellipse cx="130" cy="128" rx="8" ry="4" fill="#FFB6C1" opacity="0.7"/>
        <ellipse cx="102" cy="128" rx="5.5" ry="4.5" fill="#FFB6C1" stroke="#2A2A2A" stroke-width="1.5"/>
        <ellipse cx="100" cy="126.5" rx="1.8" ry="1.2" fill="#FFFFFF"/>
        <path d="M 92 140 Q 102 152 112 140" stroke="#2A2A2A" stroke-width="2.5" fill="none" stroke-linecap="round"/>
        <ellipse cx="58" cy="178" rx="10" ry="22" fill="#FFB703" stroke="#2A2A2A" stroke-width="2.5" transform="rotate(-25 58 178)"/>
        <g transform="translate(42 148) rotate(-25) scale(0.85)">
          <path d="M -5 -2 L 5 -2 L 6 1 L -6 1 Z" fill="#7B5A30" stroke="#2A2A2A" stroke-width="1.4" stroke-linejoin="round"/>
          <path d="M -12 0 L 12 0 C 14 18, 10 40, 0 52 C -10 40, -14 18, -12 0 Z" fill="#FF8C42" stroke="#2A2A2A" stroke-width="2.3" stroke-linejoin="round"/>
          <path d="M -10 14 Q 0 17 10 14" stroke="#CC6A28" stroke-width="1.2" fill="none" opacity="0.55" stroke-linecap="round"/>
          <path d="M -8 28 Q 0 31 7 28" stroke="#CC6A28" stroke-width="1.1" fill="none" opacity="0.55" stroke-linecap="round"/>
          <path d="M -5 40 Q 0 42 4 40" stroke="#CC6A28" stroke-width="1" fill="none" opacity="0.55" stroke-linecap="round"/>
          <path d="M -8 6 Q -10 24 -5 38" stroke="#FFFFFF" stroke-width="1.6" fill="none" opacity="0.7" stroke-linecap="round"/>
          <path d="M 0 -3 Q -2.5 -16 0 -23 Q 2.5 -16 0 -3 Z" fill="#7CB342" stroke="#2A2A2A" stroke-width="1.6" stroke-linejoin="round"/>
          <line x1="0" y1="-5" x2="0" y2="-20" stroke="#558B2F" stroke-width="0.9" opacity="0.7"/>
          <path d="M -3 -2 Q -11 -10 -10 -19 Q -4 -13 -1 -3 Z" fill="#7CB342" stroke="#2A2A2A" stroke-width="1.5" stroke-linejoin="round"/>
          <line x1="-3" y1="-5" x2="-8" y2="-15" stroke="#558B2F" stroke-width="0.8" opacity="0.7"/>
          <path d="M 3 -2 Q 11 -10 10 -19 Q 4 -13 1 -3 Z" fill="#7CB342" stroke="#2A2A2A" stroke-width="1.5" stroke-linejoin="round"/>
          <line x1="3" y1="-5" x2="8" y2="-15" stroke="#558B2F" stroke-width="0.8" opacity="0.7"/>
        </g>
        <ellipse cx="148" cy="180" rx="9" ry="20" fill="#FFB703" stroke="#2A2A2A" stroke-width="2.5"/>
        <ellipse cx="80" cy="232" rx="14" ry="7" fill="#FFB703" stroke="#2A2A2A" stroke-width="2"/>
        <ellipse cx="120" cy="232" rx="14" ry="7" fill="#FFB703" stroke="#2A2A2A" stroke-width="2"/>
        <ellipse cx="78" cy="231" rx="6" ry="2.5" fill="#FFB6C1" opacity="0.6"/>
        <ellipse cx="118" cy="231" rx="6" ry="2.5" fill="#FFB6C1" opacity="0.6"/>
      </symbol>
    </defs>
  </svg>

  <div class="ambient">
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
    <div class="glow glow-3"></div>
  </div>

  <SiteHeader locale={locale} strings={t} />


  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-grid">
          <div>
            <h1>
              {t.hero.h1.pre}<span class="serif">{t.hero.h1.italic}</span>{t.hero.h1.post ?? ''}
            </h1>
            <p class="hero-pitch">{t.hero.pitch}</p>
            <div class="cta-row">
              <a href={playStoreUrl} class="store-badge" aria-label={t.hero.ctaPrimary}>
                <img src={playBadgeSrc} alt={t.hero.ctaPrimary} width="180" height="70" loading="eager" decoding="async" />
              </a>
              <a href={appStoreUrl} class="store-badge" aria-label={t.platform.iosBadgeAlt}>
                <img src={appStoreBadgeSrc} alt={t.platform.iosBadgeAlt} width="210" height="70" loading="eager" decoding="async" />
              </a>
              <a href="#cosa-fa" class="cta-ghost">{t.hero.ctaGhost}</a>
            </div>
            <p class="platform-line">
              <span class="platform-line__badge">
                <svg viewBox="0 0 24 24" aria-hidden="true" width="14" height="14"><path fill="currentColor" d="M17.6 9.48l1.84-3.18a.36.36 0 0 0-.13-.49.36.36 0 0 0-.49.13L17 9.13A11.5 11.5 0 0 0 12 8a11.5 11.5 0 0 0-5 1.13L5.18 5.94a.36.36 0 0 0-.49-.13.36.36 0 0 0-.13.49L6.4 9.48A10.81 10.81 0 0 0 1 18h22a10.81 10.81 0 0 0-5.4-8.52ZM7 15.25a1.25 1.25 0 1 1 1.25-1.25A1.25 1.25 0 0 1 7 15.25Zm10 0a1.25 1.25 0 1 1 1.25-1.25 1.25 1.25 0 0 1-1.25 1.25Z"/></svg>
                {t.platform.availableOn}
              </span>
            </p>
          </div>

          <div class="hop-card">
            <div class="hop-card-pill stage">
              <span class="star">★</span>
              {t.hero.cardStage}
            </div>
            <div class="hop-card-pill carrot">🥕 7</div>
            <svg class="hop-card-sprite" viewBox="0 0 220 260">
              <use href="#hop-full"/>
            </svg>
            <div class="hop-card-overwhelm"><span>✨</span> {t.hero.cardOverwhelm}</div>
            <div class="hop-card-stats">
              <div class="stat-row">
                <span class="icon">⚡</span>
                <span style="min-width: 50px;">94 / 100</span>
                <span class="stat-bar"><span style="width: 94%"></span></span>
              </div>
              <div class="stat-row">
                <span class="icon" style="font-size: 11px; opacity: 0.8;">XP</span>
                <span style="font-size: 11px; opacity: 0.85;">{t.hero.cardStatLevel}</span>
                <span class="stat-bar xp"><span style="width: 38%"></span></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="perche">
      <div class="container">
        <div class="reveal">
          <div class="eyebrow">{t.perche.eyebrow}</div>
          <h2 class="section-title">
            {t.perche.title.pre}<span class="serif">{t.perche.title.italic}</span>{t.perche.title.post ?? ''}
          </h2>
          <p class="section-subtitle">{t.perche.subtitle}</p>
        </div>
        <div class="split-list">
          {t.perche.items.map((item, i) => {
            const palette = [
              'rgba(255, 183, 3, 0.18)',
              'rgba(78, 205, 196, 0.18)',
              'rgba(199, 186, 255, 0.18)',
            ];
            const icons = ['🐰', '💛', '🔒'];
            return (
              <div class="split-item reveal">
                <div class="ico" style={`--ico-bg: ${palette[i] ?? palette[0]};`}>{icons[i] ?? '✨'}</div>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <section id="cosa-fa" class="bg-deep">
      <div class="container">
        <div class="reveal">
          <div class="eyebrow">{t.cosaFa.eyebrow}</div>
          <h2 class="section-title">
            {t.cosaFa.title.pre}<span class="serif">{t.cosaFa.title.italic}</span>{t.cosaFa.title.post ?? ''}
          </h2>
          <p class="section-subtitle">{t.cosaFa.subtitle}</p>
        </div>
        <div class="moduli-grid">
          {t.cosaFa.moduli.map((m, i) => {
            const styles = [
              { color: '#FFA726', bg: 'rgba(255, 167, 38, 0.14)', icon: '🍅' },
              { color: '#E63946', bg: 'rgba(230, 57, 70, 0.14)', icon: '💊' },
              { color: '#219EBC', bg: 'rgba(33, 158, 188, 0.14)', icon: '🧠' },
              { color: '#C7BAFF', bg: 'rgba(199, 186, 255, 0.14)', icon: '🪄' },
              { color: '#66BB6A', bg: 'rgba(102, 187, 106, 0.14)', icon: '📅' },
              { color: '#FF006E', bg: 'rgba(255, 0, 110, 0.14)', icon: '💭' },
              { color: '#4ECDC4', bg: 'rgba(78, 205, 196, 0.14)', icon: '🎧' },
              { color: '#FFB703', bg: 'rgba(255, 183, 3, 0.14)', icon: '⏳' },
              { color: '#FFA726', bg: 'rgba(255, 167, 38, 0.14)', icon: '🏠' },
            ];
            const s = styles[i] ?? styles[0];
            return (
              <div class="modulo reveal" style={`--mod-color: ${s.color}; --mod-bg: ${s.bg};`}>
                <div class="modulo-icon">{s.icon}</div>
                <h3>{m.title}</h3>
                <p>{m.body}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <section id="widget">
      <div class="container">
        <div class="reveal">
          <div class="eyebrow">{t.widget.eyebrow}</div>
          <h2 class="section-title">
            {t.widget.title.pre}<span class="serif">{t.widget.title.italic}</span>{t.widget.title.post ?? ''}
          </h2>
          <p class="section-subtitle">{t.widget.subtitle}</p>
        </div>
        <div class="widget-grid">
          {t.widget.items.map((w) => (
            <div class="widget-card reveal">
              <div class="widget-card-img">
                <Picture src={`/img/${w.src}.png`} alt={w.title} width={640} height={360} loading="lazy" />
              </div>
              <h3>{w.title}</h3>
              <p>{w.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <div class="audience reveal">
          <div class="eyebrow">{t.audience.eyebrow}</div>
          <h2>
            {t.audience.title.pre}<span class="serif">{t.audience.title.italic}</span>{t.audience.title.post ?? ''}
          </h2>
          <p>{t.audience.body1}</p>
          <p style="margin-top: 18px;" set:html={t.audience.body2Html}></p>
        </div>
      </div>
    </section>

    <section id="privacy" class="bg-deep">
      <div class="container">
        <div class="reveal">
          <div class="eyebrow">{t.privacy.eyebrow}</div>
          <h2 class="section-title">
            {t.privacy.title.pre}<span class="serif">{t.privacy.title.italic}</span>{t.privacy.title.post ?? ''}
          </h2>
          <p class="section-subtitle">{t.privacy.subtitle}</p>
        </div>
        <div class="privacy-card reveal">
          <ul class="privacy-list">
            {t.privacy.bulletsHtml.map((html) => (
              <li set:html={html}></li>
            ))}
          </ul>
          <a href={privacyPolicyUrl} class="privacy-link">
            {t.privacy.linkText}
          </a>
        </div>
      </div>
    </section>

    <section id="faq">
      <div class="container">
        <div class="reveal">
          <div class="eyebrow">{t.faq.eyebrow}</div>
          <h2 class="section-title">
            {t.faq.title.pre}<span class="serif">{t.faq.title.italic}</span>{t.faq.title.post ?? ''}
          </h2>
        </div>
        <div class="faq-list">
          {t.faq.items.map((item) => (
            <details class="faq reveal">
              <summary>{item.q}</summary>
              <div class="faq-body">
                {item.a.map((p) => (
                  <p set:html={p}></p>
                ))}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <div class="final-cta reveal">
          <div class="final-cta-inner">
            <h2>
              {t.finalCta.title.pre}<span class="serif">{t.finalCta.title.italic}</span>{t.finalCta.title.post ?? ''}
            </h2>
            <p>{t.finalCta.body}</p>
            <div class="cta-row cta-row--center">
              <a href={playStoreUrl} class="store-badge store-badge--final" aria-label={t.finalCta.cta}>
                <img src={playBadgeSrc} alt={t.finalCta.cta} width="200" height="78" loading="lazy" decoding="async" />
              </a>
              <a href={appStoreUrl} class="store-badge store-badge--final" aria-label={t.platform.iosBadgeAlt}>
                <img src={appStoreBadgeSrc} alt={t.platform.iosBadgeAlt} width="234" height="78" loading="lazy" decoding="async" />
              </a>
            </div>
            <p class="platform-line platform-line--final">
              <span class="platform-line__badge">{t.platform.availableOn}</span>
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} strings={t} />

  <script>
    const header = document.getElementById('header');
    if (header) {
      window.addEventListener('scroll', () => {
        header.classList.toggle('scrolled', window.scrollY > 8);
      });
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  </script>
</BaseLayout>

<style>
  .moduli-grid {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }
  .modulo h3 {
    font-size: 16px;
  }
  .split-item h3 .serif {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
  }
  .audience p strong {
    font-weight: 600;
  }

</style>
