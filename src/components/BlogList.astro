---
import type { CollectionEntry } from 'astro:content';
import type { LandingStrings, Locale } from '../i18n/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';

export interface Props {
  locale: Locale;
  strings: LandingStrings;
  posts: CollectionEntry<'blog'>[];
  tagFilter?: string;
}

const { locale, strings: t, posts, tagFilter } = Astro.props;

const homePathByLocale: Record<Locale, string> = {
  it: '/',
  en: '/en/',
  es: '/es/',
  de: '/de/',
  fr: '/fr/',
};
const homeHref = homePathByLocale[locale];
const blogHref = `${homeHref}blog/`.replace(/\/+/g, '/');

const sortedPosts = [...posts].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const latestForSidebar = sortedPosts.slice(0, 5);

const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.dopahop.android';

function postUrl(post: CollectionEntry<'blog'>): string {
  const cleanSlug = post.slug.replace(new RegExp(`^${post.data.locale}/`), '');
  return `${blogHref}${cleanSlug}/`.replace(/\/+/g, '/');
}

function tagUrl(tag: string): string {
  return `${blogHref}tag/${encodeURIComponent(tag.toLowerCase())}/`.replace(/\/+/g, '/');
}

function readingMinutes(post: CollectionEntry<'blog'>): number {
  const wc = post.body.split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(wc / 200));
}

// Stable tag color palette (deterministic by tag string)
const tagPalette = [
  { bg: 'rgba(255, 183, 3, 0.14)', fg: '#FFB703' },
  { bg: 'rgba(78, 205, 196, 0.14)', fg: '#4ECDC4' },
  { bg: 'rgba(199, 186, 255, 0.18)', fg: '#C7BAFF' },
  { bg: 'rgba(255, 0, 110, 0.12)', fg: '#FF6B9D' },
  { bg: 'rgba(102, 187, 106, 0.16)', fg: '#66BB6A' },
  { bg: 'rgba(33, 158, 188, 0.18)', fg: '#5FB6CF' },
];

function tagColor(tag: string) {
  let h = 0;
  for (let i = 0; i < tag.length; i++) h = (h * 31 + tag.charCodeAt(i)) >>> 0;
  return tagPalette[h % tagPalette.length];
}

const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const siteUrl = 'https://dopahop.app';
const pageBlogPath = tagFilter
  ? `${blogHref}tag/${encodeURIComponent(tagFilter.toLowerCase())}/`.replace(/\/+/g, '/')
  : blogHref;
const canonical = new URL(pageBlogPath, siteUrl).toString();

const alternateLocales = tagFilter
  ? undefined  // tag pages: hreflang only between same-tag pages, but tags may differ per language → no alternates
  : [
      { code: 'it', href: new URL('/blog/', siteUrl).toString() },
      { code: 'en', href: new URL('/en/blog/', siteUrl).toString() },
      { code: 'es', href: new URL('/es/blog/', siteUrl).toString() },
      { code: 'de', href: new URL('/de/blog/', siteUrl).toString() },
      { code: 'fr', href: new URL('/fr/blog/', siteUrl).toString() },
      { code: 'x-default', href: new URL('/blog/', siteUrl).toString() },
    ];

const pageTitle = tagFilter
  ? `${t.blog.tags}: ${tagFilter} — ${t.blog.metaTitle}`
  : t.blog.metaTitle;
const pageDescription = tagFilter
  ? `${t.blog.metaDescription} — Tag: ${tagFilter}`
  : t.blog.metaDescription;

const blogListSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: t.blog.metaTitle,
  description: t.blog.metaDescription,
  url: canonical,
  inLanguage: locale,
  blogPost: sortedPosts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    url: new URL(postUrl(post), siteUrl).toString(),
  })),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  canonical={canonical}
  alternateLocales={alternateLocales}
>
  <script type="application/ld+json" set:html={JSON.stringify(blogListSchema)} />

  <div class="ambient">
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
    <div class="glow glow-3"></div>
  </div>

  <SiteHeader locale={locale} strings={t} />

  <main>
    <section class="blog-hero">
      <div class="container">
        <div class="blog-hero-inner reveal">
          <span class="blog-hero-pill">
            <span class="blog-hero-dot"></span>
            {tagFilter ? t.blog.tags : t.blog.pageTitle}
          </span>
          <h1 class="blog-hero-title">
            {tagFilter
              ? `#${tagFilter}`
              : t.blog.metaTitle.replace('DopaHop Blog — ', '').replace('Blog DopaHop — ', '')}
          </h1>
          <p class="blog-hero-subtitle">
            {tagFilter
              ? `${sortedPosts.length} ${sortedPosts.length === 1 ? 'articolo' : 'articoli'}`
              : t.blog.pageSubtitle}
          </p>
          {tagFilter && (
            <p class="blog-hero-back">
              <a href={blogHref}>{t.blog.backToBlog}</a>
            </p>
          )}
        </div>
      </div>
    </section>

    <section class="blog-main-section">
      <div class="container">
        <div class="blog-layout">
          <div class="blog-main">
            {sortedPosts.length === 0 ? (
              <div class="blog-empty reveal">
                <div class="blog-empty-icon">📝</div>
                <p>{t.blog.emptyState}</p>
              </div>
            ) : (
              <div class="blog-grid">
                {sortedPosts.map((post) => (
                  <a href={postUrl(post)} class="blog-card reveal" aria-label={post.data.title}>
                    {post.data.cover && (
                      <div class="blog-card-cover">
                        <img src={post.data.cover} alt={post.data.title} loading="lazy" />
                      </div>
                    )}
                    <div class="blog-card-body">
                      {post.data.tags.length > 0 && (
                        <div class="blog-card-tags">
                          {post.data.tags.slice(0, 2).map((tag) => {
                            const c = tagColor(tag);
                            return (
                              <a href={tagUrl(tag)} class="blog-card-tag" style={`background: ${c.bg}; color: ${c.fg};`}>{tag}</a>
                            );
                          })}
                        </div>
                      )}
                      <h2 class="blog-card-title">{post.data.title}</h2>
                      <p class="blog-card-excerpt">{post.data.excerpt ?? post.data.description}</p>
                      <div class="blog-card-meta">
                        <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.pubDate)}</time>
                        <span aria-hidden="true">·</span>
                        <span>{readingMinutes(post)} {t.blog.minRead}</span>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            )}
          </div>

          <aside class="blog-sidebar reveal">
            <div class="sidebar-card sidebar-app">
              <img src="/img/icon.png" alt="DopaHop" class="sidebar-app-icon" width="56" height="56" />
              <h3 class="sidebar-app-title">{t.blog.appCardTitle}</h3>
              <p class="sidebar-app-subtitle">{t.blog.appCardSubtitle}</p>
              <a href={playStoreUrl} class="sidebar-app-cta">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 1.5L13.5 12 3.6 22.5c-.6-.4-1-1-1-1.7V3.2c0-.7.4-1.3 1-1.7zM14.6 13.1l2.5 2.6-12.4 7.1 9.9-9.7zm0-2.2l-9.9-9.7 12.4 7.1-2.5 2.6zm6.6.7c.8.4 1.3 1.2 1.3 2.1 0 .9-.5 1.7-1.3 2.1l-2.7 1.6-2.8-2.7 2.8-2.7 2.7 1.6z"/></svg>
                {t.blog.appCardCta}
              </a>
            </div>

            {latestForSidebar.length > 0 && (
              <div class="sidebar-card">
                <h3 class="sidebar-title">{t.blog.latestArticles}</h3>
                <ul class="sidebar-list">
                  {latestForSidebar.map((post) => (
                    <li class="sidebar-list-item">
                      <a href={postUrl(post)} class="sidebar-list-link">
                        <h4 class="sidebar-list-title">{post.data.title}</h4>
                        <time datetime={post.data.pubDate.toISOString()} class="sidebar-list-date">
                          {dateFormatter.format(post.data.pubDate)}
                        </time>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </aside>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} strings={t} />

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    const header = document.getElementById('header');
    if (header) {
      window.addEventListener('scroll', () => {
        header.classList.toggle('scrolled', window.scrollY > 8);
      });
    }
  </script>
</BaseLayout>

<style>
  /* ── HERO ── */
  .blog-hero {
    padding: 80px 0 32px;
    text-align: center;
  }
  .blog-hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .blog-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 16px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    font-size: 12px;
    font-weight: 700;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 24px;
  }
  .blog-hero-dot {
    width: 7px;
    height: 7px;
    background: var(--primary);
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(255, 183, 3, 0.18);
  }
  .blog-hero-title {
    font-size: clamp(38px, 5.4vw, 60px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.04;
    margin-bottom: 22px;
    color: var(--ink);
  }
  .blog-hero-subtitle {
    color: var(--ink-soft);
    font-size: clamp(16px, 1.7vw, 18px);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ── 2-COL LAYOUT ── */
  .blog-main-section {
    padding: 16px 0 96px;
  }
  .blog-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 40px;
    align-items: start;
  }
  @media (max-width: 960px) {
    .blog-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .blog-main {
    min-width: 0;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }

  /* ── SIDEBAR ── */
  .blog-sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: sticky;
    top: 88px;
  }
  @media (max-width: 960px) {
    .blog-sidebar { position: static; }
  }
  .sidebar-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 22px 24px;
  }
  .sidebar-title {
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  /* App download card */
  .sidebar-app {
    background: linear-gradient(160deg, var(--surface) 0%, rgba(255, 183, 3, 0.08) 100%);
    border-color: rgba(255, 183, 3, 0.28);
    text-align: center;
    padding: 28px 22px;
  }
  .sidebar-app-icon {
    border-radius: 14px;
    box-shadow: var(--shadow-brand);
    margin: 0 auto 14px;
    display: block;
  }
  .sidebar-app-title {
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .sidebar-app-subtitle {
    font-size: 13.5px;
    color: var(--ink-soft);
    line-height: 1.5;
    margin-bottom: 18px;
  }
  .sidebar-app-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--primary);
    color: var(--bg);
    padding: 11px 20px;
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: 14px;
    box-shadow: var(--shadow-brand);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .sidebar-app-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(255, 183, 3, 0.4);
  }
  .sidebar-app-cta svg {
    width: 14px;
    height: 14px;
  }

  /* Latest articles list */
  .sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .sidebar-list-item + .sidebar-list-item {
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .sidebar-list-link {
    display: block;
    color: inherit;
    transition: color 0.15s ease;
  }
  .sidebar-list-link:hover .sidebar-list-title {
    color: var(--primary);
  }
  .sidebar-list-title {
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
    letter-spacing: -0.01em;
    margin-bottom: 4px;
    transition: color 0.15s ease;
  }
  .sidebar-list-date {
    font-size: 11.5px;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }
  .blog-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }
  .blog-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }
  .blog-card-cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-elevated);
    position: relative;
  }
  .blog-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .blog-card:hover .blog-card-cover img {
    transform: scale(1.04);
  }
  .blog-card-body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }
  .blog-card-title {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--ink);
  }
  .blog-card-excerpt {
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.55;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card-meta {
    font-size: 12px;
    color: var(--ink-muted);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .blog-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .blog-card-tag {
    font-size: 10.5px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: inline-block;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  a.blog-card-tag:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }
  .blog-hero-back {
    margin-top: 16px;
    font-size: 14px;
  }
  .blog-hero-back a {
    color: var(--primary);
    font-weight: 700;
  }
  .blog-card-link {
    font-size: 14px;
    font-weight: 700;
    color: var(--primary);
    transition: gap 0.2s ease;
  }
  .blog-card:hover .blog-card-link {
    color: var(--primary-light);
  }

  /* ── EMPTY ── */
  .blog-empty {
    text-align: center;
    padding: 80px 24px;
    color: var(--ink-soft);
  }
  .blog-empty-icon {
    font-size: 48px;
    margin-bottom: 12px;
    opacity: 0.7;
  }
  .blog-empty p { font-size: 17px; }
</style>
