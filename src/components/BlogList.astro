---
import type { CollectionEntry } from 'astro:content';
import type { LandingStrings, Locale } from '../i18n/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';

export interface Props {
  locale: Locale;
  strings: LandingStrings;
  posts: CollectionEntry<'blog'>[];
}

const { locale, strings: t, posts } = Astro.props;

const homePathByLocale: Record<Locale, string> = {
  it: '/',
  en: '/en/',
  es: '/es/',
  de: '/de/',
  fr: '/fr/',
};
const homeHref = homePathByLocale[locale];
const blogHref = `${homeHref}blog/`.replace(/\/+/g, '/');

const sortedPosts = [...posts].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

function postUrl(post: CollectionEntry<'blog'>): string {
  const cleanSlug = post.slug.replace(new RegExp(`^${post.data.locale}/`), '');
  return `${blogHref}${cleanSlug}/`.replace(/\/+/g, '/');
}

const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const siteUrl = 'https://dopahop.app';
const canonical = new URL(blogHref, siteUrl).toString();

const alternateLocales = [
  { code: 'it', href: new URL('/blog/', siteUrl).toString() },
  { code: 'en', href: new URL('/en/blog/', siteUrl).toString() },
  { code: 'es', href: new URL('/es/blog/', siteUrl).toString() },
  { code: 'de', href: new URL('/de/blog/', siteUrl).toString() },
  { code: 'fr', href: new URL('/fr/blog/', siteUrl).toString() },
  { code: 'x-default', href: new URL('/blog/', siteUrl).toString() },
];

const blogListSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: t.blog.metaTitle,
  description: t.blog.metaDescription,
  url: canonical,
  inLanguage: locale,
  blogPost: sortedPosts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    url: new URL(postUrl(post), siteUrl).toString(),
  })),
};
---

<BaseLayout
  title={t.blog.metaTitle}
  description={t.blog.metaDescription}
  locale={locale}
  canonical={canonical}
  alternateLocales={alternateLocales}
>
  <script type="application/ld+json" set:html={JSON.stringify(blogListSchema)} />

  <div class="ambient">
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
  </div>

  <SiteHeader locale={locale} strings={t} showAnchorNav={false} />

  <main>
    <section class="blog-hero">
      <div class="container">
        <div class="reveal">
          <div class="eyebrow">{t.blog.pageTitle}</div>
          <h1 class="blog-hero-title">{t.blog.metaTitle.replace('DopaHop Blog — ', '').replace('Blog DopaHop — ', '')}</h1>
          <p class="blog-hero-subtitle">{t.blog.pageSubtitle}</p>
        </div>
      </div>
    </section>

    <section class="blog-grid-section">
      <div class="container">
        {sortedPosts.length === 0 ? (
          <div class="blog-empty reveal">
            <p>{t.blog.emptyState}</p>
          </div>
        ) : (
          <div class="blog-grid">
            {sortedPosts.map((post) => (
              <a href={postUrl(post)} class="blog-card reveal" aria-label={post.data.title}>
                {post.data.cover && (
                  <div class="blog-card-cover">
                    <img src={post.data.cover} alt={post.data.title} loading="lazy" />
                  </div>
                )}
                <div class="blog-card-body">
                  <div class="blog-card-meta">
                    <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.pubDate)}</time>
                  </div>
                  <h2 class="blog-card-title">{post.data.title}</h2>
                  <p class="blog-card-excerpt">{post.data.excerpt ?? post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <div class="blog-card-tags">
                      {post.data.tags.map((tag) => (
                        <span class="blog-card-tag">{tag}</span>
                      ))}
                    </div>
                  )}
                  <span class="blog-card-link">{t.blog.readMore} →</span>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} strings={t} />

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    const header = document.getElementById('header');
    if (header) {
      window.addEventListener('scroll', () => {
        header.classList.toggle('scrolled', window.scrollY > 8);
      });
    }
  </script>
</BaseLayout>

<style>
  .blog-hero {
    padding: 96px 0 48px;
  }
  .blog-hero-title {
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 18px;
    text-align: center;
  }
  .blog-hero-subtitle {
    text-align: center;
    color: var(--ink-soft);
    font-size: 17px;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.55;
  }
  .blog-hero .eyebrow { text-align: center; }

  .blog-grid-section {
    padding: 32px 0 96px;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }
  .blog-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }
  .blog-card:hover {
    transform: translateY(-3px);
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }
  .blog-card-cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-elevated);
  }
  .blog-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .blog-card-body {
    padding: 22px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .blog-card-meta {
    font-size: 12px;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }
  .blog-card-title {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--ink);
  }
  .blog-card-excerpt {
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.55;
    flex: 1;
  }
  .blog-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .blog-card-tag {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: var(--radius-full);
    background: var(--surface-elevated);
    color: var(--ink-soft);
  }
  .blog-card-link {
    font-size: 14px;
    font-weight: 700;
    color: var(--primary);
    margin-top: 4px;
  }

  .blog-empty {
    text-align: center;
    padding: 80px 0;
    color: var(--ink-soft);
    font-size: 17px;
  }
</style>
