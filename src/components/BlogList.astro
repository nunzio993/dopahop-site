---
import type { CollectionEntry } from 'astro:content';
import type { LandingStrings, Locale } from '../i18n/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';

export interface Props {
  locale: Locale;
  strings: LandingStrings;
  posts: CollectionEntry<'blog'>[];
}

const { locale, strings: t, posts } = Astro.props;

const homePathByLocale: Record<Locale, string> = {
  it: '/',
  en: '/en/',
  es: '/es/',
  de: '/de/',
  fr: '/fr/',
};
const homeHref = homePathByLocale[locale];
const blogHref = `${homeHref}blog/`.replace(/\/+/g, '/');

const sortedPosts = [...posts].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const [featuredPost, ...restPosts] = sortedPosts;

function postUrl(post: CollectionEntry<'blog'>): string {
  const cleanSlug = post.slug.replace(new RegExp(`^${post.data.locale}/`), '');
  return `${blogHref}${cleanSlug}/`.replace(/\/+/g, '/');
}

function readingMinutes(post: CollectionEntry<'blog'>): number {
  const wc = post.body.split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(wc / 200));
}

// Stable tag color palette (deterministic by tag string)
const tagPalette = [
  { bg: 'rgba(255, 183, 3, 0.14)', fg: '#FFB703' },
  { bg: 'rgba(78, 205, 196, 0.14)', fg: '#4ECDC4' },
  { bg: 'rgba(199, 186, 255, 0.18)', fg: '#C7BAFF' },
  { bg: 'rgba(255, 0, 110, 0.12)', fg: '#FF6B9D' },
  { bg: 'rgba(102, 187, 106, 0.16)', fg: '#66BB6A' },
  { bg: 'rgba(33, 158, 188, 0.18)', fg: '#5FB6CF' },
];

function tagColor(tag: string) {
  let h = 0;
  for (let i = 0; i < tag.length; i++) h = (h * 31 + tag.charCodeAt(i)) >>> 0;
  return tagPalette[h % tagPalette.length];
}

const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const siteUrl = 'https://dopahop.app';
const canonical = new URL(blogHref, siteUrl).toString();

const alternateLocales = [
  { code: 'it', href: new URL('/blog/', siteUrl).toString() },
  { code: 'en', href: new URL('/en/blog/', siteUrl).toString() },
  { code: 'es', href: new URL('/es/blog/', siteUrl).toString() },
  { code: 'de', href: new URL('/de/blog/', siteUrl).toString() },
  { code: 'fr', href: new URL('/fr/blog/', siteUrl).toString() },
  { code: 'x-default', href: new URL('/blog/', siteUrl).toString() },
];

const blogListSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: t.blog.metaTitle,
  description: t.blog.metaDescription,
  url: canonical,
  inLanguage: locale,
  blogPost: sortedPosts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    url: new URL(postUrl(post), siteUrl).toString(),
  })),
};
---

<BaseLayout
  title={t.blog.metaTitle}
  description={t.blog.metaDescription}
  locale={locale}
  canonical={canonical}
  alternateLocales={alternateLocales}
>
  <script type="application/ld+json" set:html={JSON.stringify(blogListSchema)} />

  <div class="ambient">
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
    <div class="glow glow-3"></div>
  </div>

  <SiteHeader locale={locale} strings={t} />

  <main>
    <section class="blog-hero">
      <div class="container">
        <div class="blog-hero-inner reveal">
          <span class="blog-hero-pill">
            <span class="blog-hero-dot"></span>
            {t.blog.pageTitle}
          </span>
          <h1 class="blog-hero-title">
            {t.blog.metaTitle.replace('DopaHop Blog — ', '').replace('Blog DopaHop — ', '')}
          </h1>
          <p class="blog-hero-subtitle">{t.blog.pageSubtitle}</p>
        </div>
      </div>
    </section>

    {sortedPosts.length === 0 ? (
      <section class="blog-grid-section">
        <div class="container">
          <div class="blog-empty reveal">
            <div class="blog-empty-icon">📝</div>
            <p>{t.blog.emptyState}</p>
          </div>
        </div>
      </section>
    ) : (
      <>
        {featuredPost && (
          <section class="blog-featured-section">
            <div class="container">
              <a href={postUrl(featuredPost)} class="blog-featured reveal" aria-label={featuredPost.data.title}>
                <div class:list={['blog-featured-cover', { 'is-placeholder': !featuredPost.data.cover }]}>
                  {featuredPost.data.cover ? (
                    <img src={featuredPost.data.cover} alt={featuredPost.data.title} loading="eager" />
                  ) : (
                    <div class="blog-cover-glyph" aria-hidden="true">
                      <span>{featuredPost.data.title.slice(0, 1)}</span>
                    </div>
                  )}
                </div>
                <div class="blog-featured-body">
                  {featuredPost.data.tags.length > 0 && (
                    <div class="blog-card-tags">
                      {featuredPost.data.tags.map((tag) => {
                        const c = tagColor(tag);
                        return (
                          <span class="blog-card-tag" style={`background: ${c.bg}; color: ${c.fg};`}>{tag}</span>
                        );
                      })}
                    </div>
                  )}
                  <h2 class="blog-featured-title">{featuredPost.data.title}</h2>
                  <p class="blog-featured-excerpt">{featuredPost.data.excerpt ?? featuredPost.data.description}</p>
                  <div class="blog-card-meta">
                    <time datetime={featuredPost.data.pubDate.toISOString()}>
                      {dateFormatter.format(featuredPost.data.pubDate)}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>{readingMinutes(featuredPost)} {t.blog.minRead}</span>
                  </div>
                  <span class="blog-card-link">{t.blog.readMore} →</span>
                </div>
              </a>
            </div>
          </section>
        )}

        {restPosts.length > 0 && (
          <section class="blog-grid-section">
            <div class="container">
              <div class="blog-grid">
                {restPosts.map((post) => (
                  <a href={postUrl(post)} class="blog-card reveal" aria-label={post.data.title}>
                    <div class:list={['blog-card-cover', { 'is-placeholder': !post.data.cover }]}>
                      {post.data.cover ? (
                        <img src={post.data.cover} alt={post.data.title} loading="lazy" />
                      ) : (
                        <div class="blog-cover-glyph" aria-hidden="true">
                          <span>{post.data.title.slice(0, 1)}</span>
                        </div>
                      )}
                    </div>
                    <div class="blog-card-body">
                      {post.data.tags.length > 0 && (
                        <div class="blog-card-tags">
                          {post.data.tags.slice(0, 2).map((tag) => {
                            const c = tagColor(tag);
                            return (
                              <span class="blog-card-tag" style={`background: ${c.bg}; color: ${c.fg};`}>{tag}</span>
                            );
                          })}
                        </div>
                      )}
                      <h2 class="blog-card-title">{post.data.title}</h2>
                      <p class="blog-card-excerpt">{post.data.excerpt ?? post.data.description}</p>
                      <div class="blog-card-meta">
                        <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.pubDate)}</time>
                        <span aria-hidden="true">·</span>
                        <span>{readingMinutes(post)} {t.blog.minRead}</span>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </section>
        )}
      </>
    )}
  </main>

  <SiteFooter locale={locale} strings={t} />

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    const header = document.getElementById('header');
    if (header) {
      window.addEventListener('scroll', () => {
        header.classList.toggle('scrolled', window.scrollY > 8);
      });
    }
  </script>
</BaseLayout>

<style>
  /* ── HERO ── */
  .blog-hero {
    padding: 80px 0 32px;
    text-align: center;
  }
  .blog-hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .blog-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 16px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    font-size: 12px;
    font-weight: 700;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 24px;
  }
  .blog-hero-dot {
    width: 7px;
    height: 7px;
    background: var(--primary);
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(255, 183, 3, 0.18);
  }
  .blog-hero-title {
    font-size: clamp(38px, 5.4vw, 60px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.04;
    margin-bottom: 22px;
    color: var(--ink);
  }
  .blog-hero-subtitle {
    color: var(--ink-soft);
    font-size: clamp(16px, 1.7vw, 18px);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ── FEATURED ── */
  .blog-featured-section {
    padding: 24px 0 32px;
  }
  .blog-featured {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    position: relative;
  }
  .blog-featured::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, rgba(255, 183, 3, 0.0), rgba(255, 183, 3, 0.0));
    pointer-events: none;
    transition: background 0.3s ease;
  }
  .blog-featured:hover {
    border-color: var(--primary);
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }
  .blog-featured:hover::before {
    background: linear-gradient(135deg, rgba(255, 183, 3, 0.05), rgba(78, 205, 196, 0.04));
  }
  .blog-featured-cover {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-elevated);
  }
  .blog-featured-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .blog-featured:hover .blog-featured-cover img {
    transform: scale(1.04);
  }
  .blog-featured-body {
    padding: 36px 40px 36px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: center;
  }
  .blog-featured-title {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--ink);
  }
  .blog-featured-excerpt {
    font-size: 16px;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  @media (max-width: 880px) {
    .blog-featured { grid-template-columns: 1fr; }
    .blog-featured-cover { aspect-ratio: 16 / 9; }
    .blog-featured-body { padding: 28px 26px 30px; gap: 12px; }
  }

  /* ── GRID ── */
  .blog-grid-section {
    padding: 32px 0 96px;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }
  .blog-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }
  .blog-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }
  .blog-card-cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-elevated);
    position: relative;
  }
  .blog-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .blog-card:hover .blog-card-cover img {
    transform: scale(1.04);
  }
  .blog-card-body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }
  .blog-card-title {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--ink);
  }
  .blog-card-excerpt {
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.55;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card-meta {
    font-size: 12px;
    color: var(--ink-muted);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .blog-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .blog-card-tag {
    font-size: 10.5px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .blog-card-link {
    font-size: 14px;
    font-weight: 700;
    color: var(--primary);
    transition: gap 0.2s ease;
  }
  .blog-featured:hover .blog-card-link,
  .blog-card:hover .blog-card-link {
    color: var(--primary-light);
  }

  /* ── COVER PLACEHOLDER (no image) ── */
  .blog-card-cover.is-placeholder,
  .blog-featured-cover.is-placeholder {
    background: linear-gradient(135deg, #1A1A2E 0%, #232340 60%, rgba(255, 183, 3, 0.18) 100%);
    display: grid;
    place-items: center;
  }
  .blog-cover-glyph {
    font-family: var(--serif);
    font-size: clamp(64px, 14vw, 140px);
    line-height: 1;
    color: var(--primary);
    opacity: 0.4;
    font-style: italic;
  }
  .blog-cover-glyph span { display: inline-block; }

  /* ── EMPTY ── */
  .blog-empty {
    text-align: center;
    padding: 80px 24px;
    color: var(--ink-soft);
  }
  .blog-empty-icon {
    font-size: 48px;
    margin-bottom: 12px;
    opacity: 0.7;
  }
  .blog-empty p { font-size: 17px; }
</style>
